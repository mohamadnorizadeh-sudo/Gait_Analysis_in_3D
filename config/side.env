# v3.0 side-camera session settings (scripts/start_side_session.sh)
# which camera measures which leg (cam0 = left-side camera, cam1 = right-side camera)
SOURCE=L=cam0,R=cam1
# 1 = snap hip/knee/ankle to tape/cardboard markers. 0 = markerless (the product; v3.1.7: walking validation
# against the far-view iPad reference, no markers on the legs)
MARKERS=0
WEB_PORT=8080
MAX_SECONDS=3600
# shin tape position as a fraction of knee->ankle (v3.0.6: tape at mid/upper shin, above the walker tube)
SHANK_SEED=0.4
# tape search radius (px) around the pose keypoint; the hip tape sits ~85 px from the hip keypoint (v3.0.7)
MARKER_RADIUS=140
# tape brightness threshold (v3.0.7: 165 merged tapes with the trouser sheen)
MARKER_VMIN=200
# marker colour: white (tape) or tan (brown cardboard squares, v3.0.9 - white tape failed in front of a white wall)
MARKER_COLOR=tan
