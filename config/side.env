# v3.0 side-camera session settings (scripts/start_side_session.sh)
# which camera measures which leg (cam0 = left-side camera, cam1 = right-side camera)
SOURCE=L=cam0,R=cam1
# 1 = snap hip/knee/ankle to white 2 cm tape markers (trochanter, lateral knee, lateral ankle)
MARKERS=1
WEB_PORT=8080
MAX_SECONDS=3600
# shin tape position as a fraction of knee->ankle (v3.0.6: tape at mid/upper shin, above the walker tube)
SHANK_SEED=0.4
