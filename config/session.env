# Gait 3D session settings (used by scripts/start_session.sh)
CALIB=stereo_calibration.npz
MODEL=/usr/share/hailo-models/yolov8m_pose_h10.hef
ROT_LEFT=180
ROT_RIGHT=180
# subject's tape-measured bone lengths (mm): trochanter -> knee joint line -> lateral malleolus
THIGH_MM=420
SHIN_MM=410
# v2.9: camera-measured bone lengths (much closer to the phone goniometer: holds 41/43 deg vs ~40).
# Comment this line out to go back to the tape lengths above.
PROFILE=config/subject_stereo.json
WEB_PORT=8080
MAX_SECONDS=3600
