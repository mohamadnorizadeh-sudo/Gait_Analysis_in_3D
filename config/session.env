# Gait 3D session settings (used by scripts/start_session.sh)
CALIB=stereo_calibration.npz
MODEL=/usr/share/hailo-models/yolov8m_pose_h10.hef
ROT_LEFT=180
ROT_RIGHT=180
# subject's tape-measured bone lengths (mm): trochanter -> knee joint line -> lateral malleolus
THIGH_MM=420
SHIN_MM=410
WEB_PORT=8080
MAX_SECONDS=3600
